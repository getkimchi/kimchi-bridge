{
  "name": "@getkimchi/kimchi-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./work/issue-keys": "./src/work/issue-keys.ts",
    "./work/kimchi/attribution": "./src/work/kimchi/attribution.ts",
    "./work/kimchi/costs": "./src/work/kimchi/costs.ts",
    "./work/kimchi/events": "./src/work/kimchi/events.ts",
    "./work/kimchi/links": "./src/work/kimchi/links.ts",
    "./work/kimchi/native": "./src/work/kimchi/native.ts",
    "./work/kimchi/records": "./src/work/kimchi/records.ts",
    "./work/outbox": "./src/work/outbox.ts",
    "./work/protocol": "./src/work/protocol.ts"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "gen": "bun run scripts/gen-assets.ts",
    "compile": "bun run scripts/compile.ts",
    "pretest": "bun run scripts/gen-assets.ts",
    "pretypecheck": "bun run scripts/gen-assets.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "format": "biome format --write --indent-style=space --indent-width=2 --line-width=100 src test scripts package.json tsconfig.json",
    "format:check": "biome format --indent-style=space --indent-width=2 --line-width=100 src test scripts package.json tsconfig.json"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@types/bun": "1.3.11",
    "@types/semver": "^7.8.0",
    "@types/shell-quote": "^1.7.5",
    "semver": "^7.8.5",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@openai/agents-core": "^0.21.0",
    "mdast-util-from-markdown": "^2.1.0",
    "shell-quote": "^1.12.0"
  }
}
