{
  "name": "@getkimchi/kimchi-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./ledger": {
      "types": "./src/ledger/index.ts",
      "default": "./src/ledger/index.ts"
    },
    "./reconcile": {
      "types": "./src/reconcile/index.ts",
      "default": "./src/reconcile/index.ts"
    }
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "gen": "bun run scripts/gen-assets.ts",
    "compile": "bun run scripts/compile.ts",
    "pretest": "bun run scripts/gen-assets.ts",
    "pretypecheck": "bun run scripts/gen-assets.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "format": "biome format --write --indent-style=space --indent-width=2 --line-width=100 src test scripts package.json tsconfig.json",
    "format:check": "biome format --indent-style=space --indent-width=2 --line-width=100 src test scripts package.json tsconfig.json"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@types/bun": "1.3.11",
    "@types/proper-lockfile": "^4.1.4",
    "@types/semver": "^7.8.0",
    "@types/shell-quote": "^1.7.5",
    "semver": "^7.8.5",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@openai/agents-core": "^0.21.0",
    "diff": "^9.0.0",
    "mdast-util-from-markdown": "^2.1.0",
    "proper-lockfile": "^4.1.2",
    "shell-quote": "^1.12.0",
    "yaml": "^2.9.1"
  }
}
