  "schema": [
    "CREATE TABLE batch_order(batch_id TEXT PRIMARY KEY,order_key TEXT NOT NULL)",
    "CREATE TABLE batches(id TEXT PRIMARY KEY,body BLOB NOT NULL,event_ids BLOB NOT NULL,created_at INTEGER NOT NULL)",
    "CREATE TABLE bindings(source TEXT NOT NULL,session_id TEXT NOT NULL,turn_id TEXT NOT NULL,agent_id TEXT NOT NULL DEFAULT '',work_id TEXT NOT NULL,repository TEXT NOT NULL,PRIMARY KEY(source,session_id,turn_id,agent_id))",
    "CREATE TABLE blob_totals(id INTEGER PRIMARY KEY CHECK(id=1),total_bytes INTEGER NOT NULL)",
    "CREATE TABLE blobs(hash TEXT PRIMARY KEY,content BLOB NOT NULL,observed_at INTEGER NOT NULL)",
    "CREATE TABLE commits(repository TEXT NOT NULL,id TEXT NOT NULL,PRIMARY KEY(repository,id))",
    "CREATE TABLE cursors(path TEXT PRIMARY KEY,offset INTEGER NOT NULL)",
    "CREATE TABLE diagnostics(code TEXT PRIMARY KEY,count INTEGER NOT NULL,updated_at INTEGER NOT NULL)",
    "CREATE TABLE events(id TEXT PRIMARY KEY,entity_id TEXT NOT NULL,kind TEXT NOT NULL,body BLOB NOT NULL,hash TEXT NOT NULL,created_at INTEGER NOT NULL,acked_at INTEGER,blocked TEXT NOT NULL DEFAULT '')",
    "CREATE TABLE export_receipts(target TEXT NOT NULL,event_id TEXT NOT NULL,PRIMARY KEY(target,event_id))",
    "CREATE TABLE file_changes(id TEXT PRIMARY KEY,repository TEXT NOT NULL,path TEXT NOT NULL,before_hash TEXT,after_hash TEXT,work_id TEXT,quality TEXT NOT NULL,created_at INTEGER NOT NULL)",
    "CREATE TABLE file_identity(repository TEXT NOT NULL,path TEXT NOT NULL,id TEXT NOT NULL,PRIMARY KEY(repository,path))",
    "CREATE TABLE file_revisions(repository TEXT NOT NULL,file_id TEXT NOT NULL,hash TEXT NOT NULL,id TEXT NOT NULL,PRIMARY KEY(repository,file_id,hash))",
    "CREATE TABLE ledger_totals(id INTEGER PRIMARY KEY CHECK(id=1),total_bytes INTEGER NOT NULL,pending_bytes INTEGER NOT NULL)",
    "CREATE TABLE meta(key TEXT PRIMARY KEY,value TEXT NOT NULL)",
    "CREATE TABLE plans(repository TEXT NOT NULL,path TEXT NOT NULL,hash TEXT NOT NULL,work_id TEXT NOT NULL,plan_id TEXT NOT NULL,revision_id TEXT NOT NULL,PRIMARY KEY(repository,path,hash,work_id))",
    "CREATE TABLE tool_state(source TEXT NOT NULL,session_id TEXT NOT NULL,call_id TEXT NOT NULL,body BLOB NOT NULL,PRIMARY KEY(source,session_id,call_id))",
    "CREATE TABLE work(id TEXT PRIMARY KEY,repository TEXT NOT NULL,created_at INTEGER NOT NULL)",
    "CREATE INDEX entity_events ON events(entity_id)",
    "CREATE INDEX pending_events ON events(acked_at,created_at)",
    "CREATE TRIGGER batch_order_delete AFTER DELETE ON batches BEGIN DELETE FROM batch_order WHERE batch_id=old.id; END",
    "CREATE TRIGGER blob_size_delete AFTER DELETE ON blobs BEGIN UPDATE blob_totals SET total_bytes=total_bytes-length(old.content) WHERE id=1; END",
    "CREATE TRIGGER blob_size_insert AFTER INSERT ON blobs BEGIN UPDATE blob_totals SET total_bytes=total_bytes+length(new.content) WHERE id=1; END",
    "CREATE TRIGGER event_size_ack AFTER UPDATE OF acked_at ON events WHEN old.acked_at IS NULL AND new.acked_at IS NOT NULL BEGIN UPDATE ledger_totals SET pending_bytes=pending_bytes-length(new.body) WHERE id=1; END",
    "CREATE TRIGGER event_size_delete AFTER DELETE ON events BEGIN UPDATE ledger_totals SET total_bytes=total_bytes-length(old.body),pending_bytes=pending_bytes-CASE WHEN old.acked_at IS NULL THEN length(old.body) ELSE 0 END WHERE id=1; DELETE FROM export_receipts WHERE event_id=old.id; END",
    "CREATE TRIGGER event_size_insert AFTER INSERT ON events BEGIN UPDATE ledger_totals SET total_bytes=total_bytes+length(new.body),pending_bytes=pending_bytes+CASE WHEN new.acked_at IS NULL THEN length(new.body) ELSE 0 END WHERE id=1; END"
  ],
